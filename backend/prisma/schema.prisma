generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================
// CORE AUTH & ROLES
// ========================
model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  roleId         Int
  role           Role            @relation(fields: [roleId], references: [id])
  status         String          @default("active") // active, suspended
  lastLogin      DateTime?
  favorites      Favorite[]
  searchHistory  SearchHistory[]
  supportTickets SupportTicket[]
  subscriptions  Subscription[]
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique // Super Admin, Admin, Technician, User
  users       User[]
  permissions Permission[] @relation("RolePermissions")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  roles     Role[]   @relation("RolePermissions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

// ========================
// CATALOG HIERARCHY
// ========================
model Category {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  slug           String?        @unique
  description    String?        @db.Text
  icon           String?
  navigationType String         @default("brand_first") // "type_first" (e.g. Tempered Glass) or "brand_first" (Battery, Combo, etc.)
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  types          CategoryType[]
  models         Model[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("categories")
}

model CategoryType {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Normal Tempered", "Edge Tempered"
  slug        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  models      Model[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, slug])
  @@map("category_types")
}

model Brand {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String?  @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  models    Model[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Model {
  id                    Int                   @id @default(autoincrement())
  name                  String
  brandId               Int
  brand                 Brand                 @relation(fields: [brandId], references: [id])
  categoryId            Int
  category              Category              @relation(fields: [categoryId], references: [id])
  typeId                Int?
  categoryType          CategoryType?         @relation(fields: [typeId], references: [id], onDelete: SetNull)
  imageUrl              String?
  notes                 String?               @db.Text
  isVerified            Boolean               @default(false)
  isActive              Boolean               @default(true)
  lastVerifiedAt        DateTime?
  aliases               ModelAlias[]
  tags                  ModelTag[]
  compatibilityLists    CompatibilityList[]
  sourceCompatibilities CompatibilityRecord[] @relation("SourceModel")
  targetCompatibilities CompatibilityRecord[] @relation("TargetModel")
  favorites             Favorite[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([name])
  @@index([brandId])
  @@index([categoryId])
  @@index([typeId])
  @@map("models")
}

model ModelAlias {
  id        Int      @id @default(autoincrement())
  aliasName String
  modelId   Int
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([aliasName])
  @@map("model_aliases")
}

model ModelTag {
  id        Int      @id @default(autoincrement())
  tagName   String
  modelId   Int
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([tagName])
  @@map("model_tags")
}

// Retained for existing records and legacy compatibility list matching
model CompatibilityList {
  id             Int      @id @default(autoincrement())
  modelId        Int
  model          Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  compatibleWith String
  connectorType  String?
  type           String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([compatibleWith])
  @@map("compatibility_lists")
}

// Normalized Many-to-Many Compatibility Record
model CompatibilityRecord {
  id            Int       @id @default(autoincrement())
  sourceModelId Int
  sourceModel   Model     @relation("SourceModel", fields: [sourceModelId], references: [id], onDelete: Cascade)
  targetModelId Int
  targetModel   Model     @relation("TargetModel", fields: [targetModelId], references: [id], onDelete: Cascade)
  notes         String?   @db.Text
  connectorInfo String?
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  source        String?   @default("manual") // "manual", "ai_gemini", "csv_import"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sourceModelId, targetModelId])
  @@map("compatibility_records")
}

// ========================
// GEMINI AI UPDATE ENGINE
// ========================
model AiUpdateJob {
  id                      Int                 @id @default(autoincrement())
  jobId                   String              @unique
  status                  String              // "pending", "running", "completed", "failed"
  isDryRun                Boolean             @default(false)
  startedAt               DateTime            @default(now())
  finishedAt              DateTime?
  candidatesFound         Int                 @default(0)
  newModels               Int                 @default(0)
  updatedModels           Int                 @default(0)
  compatibilityCandidates Int                 @default(0)
  summaryJson             String?             @db.Text
  errorMessage            String?             @db.Text
  triggeredBy             String              @default("scheduled") // "scheduled" or "admin:email"
  candidates              AiUpdateCandidate[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@map("ai_update_jobs")
}

model AiUpdateCandidate {
  id                  Int         @id @default(autoincrement())
  jobId               Int
  job                 AiUpdateJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId         String
  operation           String      // "create_model", "update_model", "add_alias", "propose_compatibility", "no_change", "needs_review"
  brandName           String
  modelName           String
  aliasesJson         String?     @db.Text
  categorySlug        String
  typeSlug            String?
  modelAttributesJson String?     @db.Text
  compatibilityJson   String?     @db.Text
  sourcesJson         String?     @db.Text
  confidence          Float       @default(0.0)
  verificationStatus  String      @default("unverified") // "unverified", "pending_review", "approved", "rejected"
  warningsJson        String?     @db.Text
  matchedModelId      Int?
  reviewedBy          Int?
  reviewedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("ai_update_candidates")
}

model AiSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

// ========================
// SEARCH & LOGS
// ========================
model SearchKeyword {
  id        Int      @id @default(autoincrement())
  keyword   String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([count(sort: Desc)])
  @@map("search_keywords")
}

model SearchHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())

  @@map("search_history")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId   Int
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, modelId])
  @@map("favorites")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  userId    Int?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model SupportTicket {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  description String   @db.Text
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("support_tickets")
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  status    String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions")
}
